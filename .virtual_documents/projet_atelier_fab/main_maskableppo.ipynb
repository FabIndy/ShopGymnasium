# cellule 1 : Importer les modules nécessaires

import numpy as np
from env.workshop_env import WorkshopEnv

from sb3_contrib import MaskablePPO
from sb3_contrib.common.wrappers import ActionMasker

import torch
print("CUDA available :", torch.cuda.is_available())
print("Device :", torch.cuda.get_device_name(0) if torch.cuda.is_available() else "CPU")



import torch
print(torch.__version__)
print(torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())
print("Device:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else "CPU")



# cellule 2 : Définir la fonction qui retourne le masque d’actions

def mask_fn(env):
    """
    Fonction appelée par ActionMasker.
    Elle demande directement au WorkshopEnv le masque des actions possibles.
    """
    return env.get_action_mask()



# cellule 3 : Créer l’environnement brut + environnement masqué

# Environnement de base (sans wrapper)
base_env = WorkshopEnv()

# Environnement masqué
env = ActionMasker(base_env, mask_fn)

print("Environnement masqué prêt.")



# cellule 4 : Créer le modèle PPO (version GPU + hyperparamètres optimisés pour 5M steps)

from sb3_contrib import MaskablePPO

model = MaskablePPO(
    policy="MlpPolicy",
    env=env,
    verbose=0,              # logs nettoyés
    device="cuda",          # GPU

    # Hyperparamètres optimisés pour long training
    learning_rate=3e-4,
    gamma=0.99,
    gae_lambda=0.95,

    # Stabilité PPO
    n_steps=4096,
    batch_size=512,
    clip_range=0.2,
    ent_coef=0.01,
    max_grad_norm=0.5,

    #  Ajout correct du logging TensorBoard
    tensorboard_log="./tb_maskedppo"
)

print("Modèle MaskablePPO initialisé sur GPU.")



# cellule 5 

import os
os.makedirs("checkpoints", exist_ok=True)



# cellule 6 : Ajouter un callback de sauvegarde automatique du meilleur modèle

from stable_baselines3.common.callbacks import CheckpointCallback

checkpoint_callback = CheckpointCallback(
    save_freq=100_000,      # 100k transitions
    save_path="./checkpoints/",
    name_prefix="ppo_masked"
)



# Cellule 7 : Entraînement long 5 millions de steps

print("Début de l'entraînement 5 000 000 steps...")

model.learn(
    total_timesteps=5_000_000,
    callback=checkpoint_callback
)

model.save("ppo_masked_5M")
print("Entraînement terminé. Modèle sauvegardé sous 'ppo_masked_5M'.")



# cellule 8 : Test final - une semaine complète en inference

test_env = ActionMasker(WorkshopEnv(), mask_fn)

obs, info = test_env.reset()
done = False
total_reward = 0
steps = 0

while not done:
    action, _ = model.predict(obs, deterministic=True)
    obs, reward, terminated, truncated, info = test_env.step(action)
    total_reward += reward
    done = terminated or truncated
    steps += 1

print("Reward total sur une semaine :", total_reward)
print("Minutes simulées :", steps)
print("Reward moyen par jour :", total_reward / 7)




