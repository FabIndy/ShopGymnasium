# CELLULE 2 — Fonction d’affichage d’un état

def print_obs(obs, env):
    """
    Affichage corrigé de l'état observé après normalisation.
    Convertit les valeurs normalisées en valeurs réelles.
    """

    # 1) Reconstitution des valeurs réelles
    t = int(obs[0] * env.max_time)

    m1_busy = int(obs[1])
    m1_left = int(obs[2] * 100)

    m2_busy = int(obs[3])
    m2_left = int(obs[4] * 100)

    RAW = int(obs[5] * env.raw_capacity)
    P1 = int(obs[6] * env.raw_capacity)
    P2i = int(obs[7] * env.raw_capacity)
    P2 = int(obs[8] * env.raw_capacity)

    next_deliv = int(obs[9] * 10080)

    backlog_p1 = int(obs[10] * 1000)
    backlog_p2 = int(obs[11] * 1000)

    q_total = int(obs[12] * 1000)

    act_type = int(obs[13] * 4)
    act_k = int(obs[14] * 50)
    act_id = int(obs[15] * 200)

    minute_of_day = int(obs[16] * 1440)

    exp_p1 = int(obs[17] * 2000)
    exp_p2 = int(obs[18] * 20000)

    theft_risk = int(obs[19])

    week_reward = obs[20] * 1_000_000
    reward_action = obs[21] * 100_000

    time_next_sell = int(obs[22] * 15)

    # 2) Affichage propre

    print(f"=== OBSERVATION (t={t}) ===")
    print(f"M1: busy={m1_busy}, time_left={m1_left}")
    print(f"M2: busy={m2_busy}, time_left={m2_left}")

    print(f"Stock: RAW={RAW}, P1={P1}, P2_inter={P2i}, P2={P2}")

    print(f"Backlog: P1={backlog_p1}, P2={backlog_p2}")
    print(f"Demandes attendues (proxy): exp_P1={exp_p1}, exp_P2={exp_p2}")

    print(f"Livraison: next_in={next_deliv}, q_total={q_total}")

    print(f"Action: type={act_type}, k={act_k}, id={act_id}")
    print(f"Minute_of_day={minute_of_day}, time_to_next_sell={time_next_sell}")
    print(f"Theft risk={theft_risk}")

    print(f"Rewards: week={week_reward:.2f}, last_action={reward_action:.2f}")




# CELLULE 3 — Reset + affichage initial
env = WorkshopEnv()
obs, info = env.reset()

print("=== RESET ===")
print_obs(obs, env)



