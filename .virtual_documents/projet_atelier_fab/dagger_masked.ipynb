# Cellule 5 – Fonction de collecte

# fonction qui joue un épisode complet avec l’expert masqué 
# et qui renvoie les données :
# obs_list : liste des observations
#act_list : liste des actions expertes

def run_expert_episode(env: WorkshopEnv, max_steps: int = 10080):
    obs, info = env.reset()
    obs_list = []
    act_list = []
    total_reward = 0.0

    for t in range(max_steps):
        action = expert_policy_masked(env, obs)
        obs_list.append(obs.copy())
        act_list.append(action)

        obs, reward, terminated, truncated, info = env.step(action)
        total_reward += reward

        if terminated or truncated:
            break

    obs_array = np.stack(obs_list, axis=0)   # shape (T, 23)
    act_array = np.array(act_list, dtype=np.int64)  # shape (T,)

    return obs_array, act_array, total_reward, t + 1



# Cellule 6 – Test rapide sur un épisode

env = WorkshopEnv()
obs_arr, act_arr, total_reward, n_steps = run_expert_episode(env)

print("Shape obs :", obs_arr.shape)
print("Shape actions :", act_arr.shape)
print("Reward total épisode :", total_reward)
print("Steps joués :", n_steps)



