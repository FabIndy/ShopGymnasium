# Cellule 2 – expert_policy

def expert_policy(obs: np.ndarray) -> int:
    """
    Politique experte v2 :
    - Utilise uniquement l'observation obs (longueur 13).
    - Priorise P2 (très rentable), garde les machines occupées,
      et maintient un buffer de matières premières.
    """

    time              = obs[0]
    m1_busy           = obs[1]
    m1_time_left      = obs[2]
    m2_busy           = obs[3]
    m2_time_left      = obs[4]
    stock_raw         = obs[5]
    stock_p1          = obs[6]
    stock_p2_inter    = obs[7]
    stock_p2          = obs[8]
    next_delivery_cd  = obs[9]
    demande_p1        = obs[10]
    demande_p2        = obs[11]
    q_raw_incoming    = obs[12]

    m1_free = (m1_busy == 0)
    m2_free = (m2_busy == 0)

    # 0) Gestion de la MP : on garde un buffer
    if stock_raw + q_raw_incoming < 20:
        q_cmd = 10  # quantité MP
        return 149 + q_cmd  # 150..199 -> commander MP (q = a - 149)

    # 1) Remplir M2 (STEP2) dès qu'il y a du P2_inter
    if m2_free and stock_p2_inter > 0:
        k = min(int(stock_p2_inter), 5)  # batch max 5
        if k > 0:
            return 99 + k  # 100..104

    # 2) Utiliser M1 pour produire P2_inter si demande P2
    if m1_free and demande_p2 > 0 and stock_raw > 0:
        k = min(int(demande_p2), int(stock_raw), 5)
        if k > 0:
            return 49 + k  # 50..54

    # 3) Sinon, utiliser M1 pour produire P1 si backlog P1
    if m1_free and demande_p1 > 0 and stock_raw > 0:
        k = min(max(int(demande_p1), 1), int(stock_raw), 5)
        return k - 1  # 0..4

    # 4) Sinon, WAIT
    return 200  # WAIT



# Cellule 3 – expert_policy_masked

def expert_policy_masked(env: WorkshopEnv, obs: np.ndarray) -> int:
    """
    Version masquée de la politique experte :
    - récupère le mask via env.get_action_mask()
    - propose une action via expert_policy(obs)
    - si l'action est masquée, on la corrige vers une action autorisée
    """

    mask = env.get_action_mask()  # bool array de taille 201
    a = expert_policy(obs)

    # Si l'action proposée est invalide, on corrige
    if not mask[a]:
        # Priorité : WAIT si autorisé (action 200)
        if mask[200]:
            return 200
        # Sinon, on prend la première action valide disponible
        valid_actions = np.nonzero(mask)[0]
        if len(valid_actions) == 0:
            # Cas pathologique : aucune action valide ? On tente WAIT par défaut
            return 200
        return int(valid_actions[0])

    return a



