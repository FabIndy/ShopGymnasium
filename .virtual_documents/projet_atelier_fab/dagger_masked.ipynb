# Cellule 7 – Création du modèle élève (MaskablePPO)

import gymnasium as gym
from sb3_contrib import MaskablePPO
from stable_baselines3.common.buffers import DictRolloutBuffer
from gymnasium import spaces
import torch as th
import os

# Wrapper pour intégrer le mask dans les observations
class MaskedObsWrapper(gym.ObservationWrapper):
    def __init__(self, env):
        super().__init__(env)
        self.observation_space = spaces.Dict({
            "obs": env.observation_space,
            "action_mask": spaces.Box(0, 1, shape=(201,), dtype=bool)
        })

    def observation(self, obs):
        return {
            "obs": obs,
            "action_mask": self.env.get_action_mask()
        }

env_student = MaskedObsWrapper(WorkshopEnv())

model_student = MaskablePPO(
    policy="MultiInputPolicy",
    env=env_student,
    verbose=1,
    device="cuda"
)

print("Modèle élève initialisé (MaskablePPO + GPU)")




