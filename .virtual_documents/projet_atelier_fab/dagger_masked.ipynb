# Cellule 10 – Entraînement supervisé (Imitation Learning Phase 1)

import torch
import torch.nn as nn
import torch.optim as optim

def train_student_supervised(model, obs_array, act_array, epochs=3, batch_size=256):
    """
    Entraîne le modèle élève (MaskablePPO) en imitation supervisée.
    Inputs :
      - obs_array : (N, 23)
      - act_array : (N,)
    """
    policy = model.policy
    device = model.device

    X = torch.tensor(obs_array, dtype=torch.float32, device=device)
    y = torch.tensor(act_array, dtype=torch.long, device=device)

    optimizer = optim.Adam(policy.parameters(), lr=1e-4)
    loss_fn = nn.CrossEntropyLoss()

    n = len(X)
    print("\n=== Début entraînement supervisé ===")

    for epoch in range(epochs):
        perm = torch.randperm(n, device=device)

        for i in range(0, n, batch_size):
            idx = perm[i:i+batch_size]
            Xb = X[idx]
            yb = y[idx]

            #  Faux mask (obligatoire pour l'API MaskablePPO)
            dummy_mask = torch.ones((Xb.shape[0], 201), dtype=torch.bool, device=device)

            #  Extraire les features
            features = policy.extract_features({"obs": Xb, "action_mask": dummy_mask})

            #  Extraire les représentations actor
            latent_pi, _ = policy.mlp_extractor(features)

            #  Obtenir les logits bruts (ce que veut CrossEntropy)
            logits = policy.action_net(latent_pi)

            #  Calcul de la loss
            loss = loss_fn(logits, yb)

            optimizer.zero_grad()
            loss.backward()
            optimizer.step()

        print(f"  Epoch {epoch+1}/{epochs} — loss = {loss.item():.4f}")

    print("=== Fin entraînement supervisé ===")


# Entraînement initial de l’élève
train_student_supervised(model_student, dagger_obs, dagger_actions, epochs=3)



# Cellule 11 — Test du modèle élève après imitation supervisée

def run_student_episode(env, model):
    obs, _ = env.reset()
    total_reward = 0
    steps = 0

    for t in range(10080):
        mask = env.get_action_mask()

        wrapped = {
            "obs": obs,
            "action_mask": mask
        }

        action, _ = model.predict(wrapped, deterministic=True)
        obs, reward, terminated, truncated, info = env.step(action)

        total_reward += reward
        steps += 1

        if terminated or truncated:
            break

    return total_reward, steps


# Test sur une semaine complète
env_test = WorkshopEnv()
reward_student, steps_played = run_student_episode(env_test, model_student)

print("===== Test élève après imitation =====")
print("Reward élève :", reward_student)
print("Steps joués :", steps_played)
print("Reward moyen par jour :", reward_student / 7)



# ============================================
# Cellule 12 : DAgger — Boucle complète
# ============================================

N_ITERS = 8            # nombre d'itérations DAgger (à ajuster)
STEPS_PER_EP = 10080   # 7 jours

all_rewards_before = []
all_rewards_after  = []

for it in range(N_ITERS):
    print(f"\n===== DAgger itération {it+1}/{N_ITERS} =====")
    
    # 1) L'ÉLÈVE joue une semaine complète
    env_dagger = WorkshopEnv()
    obs, _ = env_dagger.reset()
    total_reward_student = 0.0
    
    dagger_obs_list = []
    dagger_act_list = []

    for t in range(STEPS_PER_EP):
        # Action de l'élève
        mask = env_dagger.get_action_mask()
        wrapped = {
            "obs": obs,
            "action_mask": mask
        }
        action_student, _ = model_student.predict(wrapped, deterministic=True)

        # Label expert POUR CET ÉTAT (cœur de DAgger)
        action_expert = expert_policy_masked(env_dagger, obs)

        # On stocke (obs, action_expert) dans le dataset DAgger
        dagger_obs_list.append(obs.copy())
        dagger_act_list.append(action_expert)

        # Step environnement avec l'action de l'élève
        obs, reward, terminated, truncated, info = env_dagger.step(action_student)
        total_reward_student += reward

        if terminated or truncated:
            break

    print(f"Reward élève pendant collecte DAgger : {total_reward_student:.2f}")
    all_rewards_before.append(total_reward_student)

    # 2) Construction du mini-dataset DAgger de cette itération
    dagger_obs_iter = np.stack(dagger_obs_list, axis=0)       # (T, 23)
    dagger_act_iter = np.array(dagger_act_list, dtype=np.int64)  # (T,)

    print("Nouvelles données DAgger :", dagger_obs_iter.shape, dagger_act_iter.shape)

    # 3) Fusion avec le buffer global (expert + DAgger)
    dagger_obs = np.concatenate([dagger_obs, dagger_obs_iter], axis=0)
    dagger_actions = np.concatenate([dagger_actions, dagger_act_iter], axis=0)

    print("Taille totale du dataset après fusion :", dagger_obs.shape, dagger_actions.shape)

    # 4) Réentraînement supervisé de l'élève sur tout le dataset cumulé
    train_student_supervised(model_student, dagger_obs, dagger_actions, epochs=3, batch_size=256)

    # 5) Évaluer l'élève après réentraînement sur une nouvelle semaine
    env_eval = WorkshopEnv()
    reward_after, steps_after = run_student_episode(env_eval, model_student)

    print(f"Reward élève après réentraînement : {reward_after:.2f}")
    print(f"Steps joués : {steps_after}")
    print(f"Reward moyen par jour : {reward_after / 7:.2f}")

    all_rewards_after.append(reward_after)

print("\n===== Récapitulatif DAgger =====")
print("Rewards élève PENDANT collecte (avant réentraînement) :", all_rewards_before)
print("Rewards élève APRÈS réentraînement :", all_rewards_after)
print(f"Reward expert v2 sur 7 jours (référence) ≈ 13601.76")
print(f"Reward élève moyenne après DAgger : {np.mean(all_rewards_after):.2f}")




